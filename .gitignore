/target
**/target
node_modules/
.venv/
__pycache__/
*.pyc
.anchor/
.DS_Store
*.log
# Raw market data never enters git (Build Plan §4: data/ holds scripts only)
simulation/data/raw/
.env
*.csv
*.parquet
*.json.gz
# Program keypair is generated locally by `anchor keys` / keygen
target/deploy/*.json
# Docs: publish only the four core docs; hide everything else under docs/.
/docs/*
!/docs/ANALYTICS.md
!/docs/ARCHITECTURE.md
!/docs/ASSUMPTIONS.md
!/docs/FORMULA.md
!/docs/PIPELINE.md
# Generated analytics output (dashboard, event dumps)
simulation/analytics/out/

# S2-27 browser E2E output (screenshots/traces)
app/test-results/

# S2-31 raw keeper run logs (never committed)
logs/

# local browser env (may contain RPC keys)
app/.env.local
app/.env*.local
