[Unit]
Description=ArbSwap Devnet quote keeper (bounded, supervised, single instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Paths are environment-specific; adjust to the host. The RPC URL and API key
# come from the gitignored EnvironmentFile (never committed, never logged).
WorkingDirectory=/opt/arbswap/scripts/devnet
EnvironmentFile=/opt/arbswap/.env
Environment=ARBSWAP_KEYPAIR=/home/ubuntu/.config/solana/id.json
ExecStart=/bin/bash -lc 'exec ./keeper_loop.sh "$ARBSWAP_RPC_URL" 600'
Restart=on-failure
RestartSec=10
# Harden: the keeper needs no privileges and holds only the keeper key.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/arbswap/logs

[Install]
WantedBy=multi-user.target
