# Production browser RPC configuration (committed; contains NO secrets).
#
# Vite inlines every VITE_* variable into the public bundle, so a provider API
# key placed in VITE_SOLANA_RPC_URL becomes a public leak. The browser must use
# a public devnet endpoint with failover (Task 9.2). This file overrides the
# local, git-ignored app/.env.local for `vite build` (production mode).
#
# If a keyed provider endpoint is ever required, it must be a separate,
# restricted, browser-scoped key — never an operator/full-access key.
VITE_ARBSWAP_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_RPC_FALLBACKS=https://api.devnet.solana.com
